{
  "name": "pi-governance",
  "version": "0.2.0",
  "description": "A pi extension that gives pi an always-ask permission prompt for every tool call, and routes its shell through the host's guard.",
  "type": "module",
  "main": "extensions/pi-governance.js",
  "exports": {
    ".": "./extensions/pi-governance.js",
    "./extension": "./extensions/pi-governance.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "pi-package",
    "pi",
    "governance",
    "permissions"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:live": "node --test test/live/*.test.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:live"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/pi-governance.git"
  }
}
